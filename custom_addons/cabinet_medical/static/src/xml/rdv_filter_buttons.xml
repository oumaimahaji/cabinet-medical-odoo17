<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//CogMenu[@t-if='!nbSelected']" position="replace">
            <ActionMenus
                t-if="!nbSelected"
                getActiveIds="() => []"
                context="props.context"
                domain="props.domain"
                items="actionMenuItems"
                resModel="model.root.resModel"
                onActionExecuted="() => model.load()"
            />
        </xpath>
    </t>

    <t t-inherit="web.CogMenu" t-inherit-mode="extension">
        <xpath expr="//i[contains(@class, 'fa-cog')]" position="after">
            <span class="o_dropdown_title ms-1">Actions</span>
        </xpath>
    </t>
    
    <t t-inherit="web.FormViewDialog.ToOne.buttons" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'o_form_button_save')]" position="replace">
            <t t-if="model.root.resModel === 'cabinet.rendezvous'">
                <button class="btn btn-primary o_form_button_save" t-on-click="saveButtonClicked" data-hotkey="c">✅ Enregistrer le RDV</button>
            </t>
            <t t-else="">
                <button class="btn btn-primary o_form_button_save" t-on-click="saveButtonClicked" data-hotkey="c">Enregistrer et fermer</button>
            </t>
        </xpath>
        <xpath expr="//button[contains(@class, 'o_form_button_cancel')]" position="replace">
            <t t-if="model.root.resModel === 'cabinet.rendezvous'">
                <button class="btn btn-secondary o_form_button_cancel" t-on-click.stop="discard" data-hotkey="j">✖ Annuler</button>
            </t>
            <t t-else="">
                <button type="button" class="btn btn-secondary o_form_button_cancel" data-hotkey="j" t-on-click.stop="discard">Annuler</button>
            </t>
        </xpath>
    </t>

</templates>
