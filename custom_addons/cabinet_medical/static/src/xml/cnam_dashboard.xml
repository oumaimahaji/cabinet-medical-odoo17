<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cabinet_medical.CnamDashboard" owl="1">
        <div class="o_action_manager o_dashboard_container p-4" style="background-color: #f4f6f9; min-height: 100vh;">
            <div class="container-fluid">
                
                <!-- HEADER & FILTERS -->
                <div class="row mb-4">
                    <div class="col-md-6 d-flex align-items-center">
                        <h2 class="text-primary fw-bold mb-0">
                            <i class="fa fa-file-text-o me-2"/> Suivi &amp; Recouvrement CNAM
                        </h2>
                    </div>
                    <div class="col-md-6 d-flex justify-content-end align-items-center gap-2">
                        <label class="fw-bold me-2">Période :</label>
                        <select class="form-select w-auto" t-on-change="onMonthChange" t-model="state.month">
                            <option value="1">Janvier</option>
                            <option value="2">Février</option>
                            <option value="3">Mars</option>
                            <option value="4">Avril</option>
                            <option value="5">Mai</option>
                            <option value="6">Juin</option>
                            <option value="7">Juillet</option>
                            <option value="8">Août</option>
                            <option value="9">Septembre</option>
                            <option value="10">Octobre</option>
                            <option value="11">Novembre</option>
                            <option value="12">Décembre</option>
                        </select>
                        <input type="number" class="form-control w-auto" t-model="state.year" t-on-change="onYearChange" style="max-width: 100px;"/>
                    </div>
                </div>

                <t t-if="state.loading">
                    <div class="d-flex align-items-center justify-content-center py-5 text-muted">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x me-3"/>
                        <h4>Chargement des données CNAM...</h4>
                    </div>
                </t>
                <t t-elif="state.error">
                    <div class="alert alert-danger">
                        Erreur lors de la récupération des statistiques CNAM.
                    </div>
                </t>
                <t t-else="">
                    <!-- 4 CARDS ROW -->
                    <div class="row g-4 mb-4">
                        
                        <!-- CARTE 1 : ENVOYÉS -->
                        <div class="col-md-4">
                            <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #0dcaf0 !important;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="text-muted fw-bold text-uppercase mb-2">Envoyés ce mois</h6>
                                            <h3 class="fw-bold mb-1"><t t-esc="state.stats.envoyes.count"/> <span class="fs-6 text-muted fw-normal">bordereaux</span></h3>
                                            <h4 class="text-info fw-bold"><t t-esc="state.stats.envoyes.amount"/> DT</h4>
                                        </div>
                                        <div class="bg-info bg-opacity-10 p-3 rounded">
                                            <i class="fa fa-paper-plane fa-2x text-info"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CARTE 2 : EN ATTENTE -->
                        <div class="col-md-4">
                            <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #fd7e14 !important;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="text-muted fw-bold text-uppercase mb-2">En Attente de Paiement</h6>
                                            <h3 class="fw-bold mb-1"><t t-esc="state.stats.attente.count"/> <span class="fs-6 text-muted fw-normal">bordereaux</span></h3>
                                            <h4 class="text-warning fw-bold" style="color: #fd7e14 !important;"><t t-esc="state.stats.attente.amount"/> DT</h4>
                                            <p class="text-muted small mb-0 mt-2"><i class="fa fa-clock-o me-1"/> Moyenne d'attente : <strong class="text-dark"><t t-esc="state.stats.attente.avg_days"/> jours</strong></p>
                                        </div>
                                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                                            <i class="fa fa-hourglass-half fa-2x" style="color: #fd7e14;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CARTE 3 : PAYÉS -->
                        <div class="col-md-4">
                            <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid #198754 !important;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="text-muted fw-bold text-uppercase mb-2">Payés ce mois</h6>
                                            <h3 class="fw-bold mb-1"><t t-esc="state.stats.payes.count"/> <span class="fs-6 text-muted fw-normal">bordereaux</span></h3>
                                            <h4 class="text-success fw-bold"><t t-esc="state.stats.payes.amount"/> DT</h4>
                                        </div>
                                        <div class="bg-success bg-opacity-10 p-3 rounded">
                                            <i class="fa fa-check-circle fa-2x text-success"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- REJETÉS LIST -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-white border-bottom-0 pt-4 pb-3">
                                    <h5 class="card-title text-danger fw-bold mb-0">
                                        <i class="fa fa-exclamation-triangle me-2"/> Bordereaux Rejetés (<t t-esc="state.stats.rejetes.length"/>)
                                    </h5>
                                </div>
                                <div class="card-body pt-0">
                                    <t t-if="state.stats.rejetes.length === 0">
                                        <div class="alert alert-success bg-success bg-opacity-10 text-success border-0 mb-0">
                                            Aucun bordereau n'est actuellement rejeté. Bravo !
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Référence</th>
                                                        <th>Montant</th>
                                                        <th>Motif de Rejet CNAM</th>
                                                        <th>Patients Concernés</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="state.stats.rejetes" t-as="rejet" t-key="rejet.name">
                                                        <tr>
                                                            <td class="fw-bold"><t t-esc="rejet.name"/></td>
                                                            <td><t t-esc="rejet.montant"/> DT</td>
                                                            <td class="text-danger fw-bold"><t t-esc="rejet.motif"/></td>
                                                            <td>
                                                                <t t-foreach="rejet.patients" t-as="patient" t-key="patient_index">
                                                                    <span class="badge bg-secondary me-1"><t t-esc="patient"/></span>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                </t>
            </div>
        </div>
    </t>
</templates>
