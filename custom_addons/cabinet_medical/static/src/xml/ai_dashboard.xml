<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cabinet_medical.AIDashboard" owl="1">
        <div class="o_action_manager o_dashboard_container p-4 overflow-auto" style="background-color: #f9fafb; min-height: 100vh; height: 100%;">
            <div class="container-fluid">
                
                <!-- HEADER -->
                <div class="row mb-4">
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <h2 class="text-primary fw-bold"><i class="fa fa-dashboard me-2"/>Tableau de Bord</h2>
                    </div>
                </div>

                <!-- TOP ROW: AI WIDGET -->
                <div class="row mb-4">
                    <div class="col-12">
                        <t t-if="state.loadingAI">
                            <div class="card shadow-sm border-0 rounded-3">
                                <div class="card-body d-flex align-items-center justify-content-center py-5 text-muted">
                                    <i class="fa fa-circle-o-notch fa-spin fa-2x me-3"/>
                                    <span>Analyse intelligente de l'activité en cours...</span>
                                </div>
                            </div>
                        </t>
                        <t t-elif="state.error">
                            <div class="text-muted">Les insights IA sont indisponibles pour le moment.</div>
                        </t>
                        <t t-elif="state.aiStats">
                            <t t-if="state.isMedecin">
                                <!-- NEW AI DASHBOARD DESIGN -->
                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <!-- Health Score -->
                                        <div class="card shadow-sm border-0 rounded-3 h-100 text-center" t-attf-style="border-bottom: 5px solid {{ state.aiStats.health_score >= 80 ? '#28a745' : (state.aiStats.health_score >= 50 ? '#ffc107' : '#dc3545') }};">
                                            <div class="card-body py-4">
                                                <h5 class="text-muted mb-3"><i class="fa fa-heartbeat me-2"/>Indice de Santé Global</h5>
                                                <div class="display-3 fw-bold" t-attf-style="color: {{ state.aiStats.health_score >= 80 ? '#28a745' : (state.aiStats.health_score >= 50 ? '#ffc107' : '#dc3545') }};">
                                                    <t t-esc="state.aiStats.health_score"/>/100
                                                </div>
                                                <p class="text-muted mt-2 small"><i class="fa fa-magic text-warning me-1"/> Calculé par l'IA</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <!-- AI Insights Grid -->
                                        <div class="card shadow-sm border-0 rounded-3 h-100">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-6 border-end">
                                                        <h6 class="text-danger fw-bold"><i class="fa fa-exclamation-circle me-2"/>Anomalies Détectées</h6>
                                                        <p class="text-muted small"><t t-esc="state.aiStats.ai_anomalies"/></p>
                                                        
                                                        <h6 class="text-success fw-bold mt-4"><i class="fa fa-check-circle me-2"/>Recommandations Cliniques &amp; Gestion</h6>
                                                        <p class="text-muted small"><t t-esc="state.aiStats.ai_recommendations"/></p>
                                                    </div>
                                                    <div class="col-md-6 ps-4">
                                                        <h6 class="text-info fw-bold"><i class="fa fa-line-chart me-2"/>Prévisions (Mois prochain)</h6>
                                                        <p class="text-muted small"><t t-esc="state.aiStats.ai_forecasts"/></p>
                                                        
                                                        <h6 class="text-primary fw-bold mt-4"><i class="fa fa-stethoscope me-2"/>Intelligence Clinique (IA)</h6>
                                                        <ul class="list-unstyled small text-muted mb-0">
                                                            <li class="mb-1"><i class="fa fa-shield text-success me-1"/> <strong>Alertes Allergies bloquées :</strong> <t t-esc="state.aiStats.nb_alertes_allergies"/> (<t t-esc="state.aiStats.nb_alertes_critiques"/> critiques)</li>
                                                            <li class="mb-1"><i class="fa fa-medkit text-info me-1"/> <strong>Top Prescriptions :</strong> <t t-esc="state.aiStats.top_medicaments"/></li>
                                                            <li class="mb-1"><i class="fa fa-users text-warning me-1"/> <strong>Patients Allergiques (Base) :</strong> <t t-esc="state.aiStats.patients_allergiques"/></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                
                                                <hr class="my-3"/>
                                                
                                                <h6 class="text-secondary fw-bold"><i class="fa fa-commenting-o me-2"/>Analyse IA Globale (Justifiée par les données)</h6>
                                                <div class="small ai-insights-content text-muted mb-0">
                                                    <t t-out="state.aiHtml"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <!-- SECRETARY VIEW (Keep old widget) -->
                                <div class="card shadow-sm border-0 rounded-3">
                                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                        <h4 class="card-title text-secondary mb-0">
                                            <i class="fa fa-magic text-warning me-2" style="font-size: 1.2em;"/> 
                                            Insights Financiers de l'Assistant Claude
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="ai-insights-content p-2">
                                            <t t-out="state.aiHtml"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- BOTTOM ROW: STATS RAPIDES (Générées à partir des données IA pour éviter de recharger) -->
                <t t-if="!state.loadingAI and state.aiStats">
                    <div class="row g-4">
                        <t t-if="state.isMedecin">
                            <!-- MÉDECIN KPIs -->
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #17a2b8;">
                                    <div class="card-body">
                                        <i class="fa fa-user-md fa-3x text-info mb-3"/>
                                        <h5 class="card-title text-muted">Consultations (Mois)</h5>
                                        <h2 class="fw-bold"><t t-esc="state.aiStats.consults_ce_mois || '0'"/></h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #28a745;">
                                    <div class="card-body">
                                        <i class="fa fa-line-chart fa-3x text-success mb-3"/>
                                        <h5 class="card-title text-muted">Tendance</h5>
                                        <h2 t-attf-class="fw-bold {{ state.aiStats.tendance_consults >= 0 ? 'text-success' : 'text-danger' }}">
                                            <t t-esc="state.aiStats.tendance_consults > 0 ? '+' : ''"/><t t-esc="state.aiStats.tendance_consults || '0'"/>
                                        </h2>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #dc3545;">
                                    <div class="card-body">
                                        <i class="fa fa-money fa-3x text-danger mb-3"/>
                                        <h5 class="card-title text-muted">Impayés Patients</h5>
                                        <h2 class="fw-bold text-danger"><t t-esc="state.aiStats.impayes_patients || '0'"/> DT</h2>
                                        <p class="text-muted small mb-0"><t t-esc="state.aiStats.nb_factures_impayees || '0'"/> factures</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #6f42c1;">
                                    <div class="card-body">
                                        <i class="fa fa-users fa-3x text-purple mb-3" style="color: #6f42c1;"/>
                                        <h5 class="card-title text-muted">Profil Dominant</h5>
                                        <h4 class="fw-bold mt-3" style="color: #6f42c1;"><t t-esc="state.aiStats.profil_dominant || 'Aucun'"/></h4>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="col-12 mt-2 mb-2">
                                <h5 class="text-secondary border-bottom pb-2"><i class="fa fa-building-o me-2"/>Suivi Financier CNAM</h5>
                            </div>
                            <!-- SECRÉTAIRE/CNAM KPIs (Original) -->
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #17a2b8;">
                                    <div class="card-body">
                                        <i class="fa fa-stethoscope fa-3x text-info mb-3"/>
                                        <h5 class="card-title text-muted">Consultations (Semaine)</h5>
                                        <h2 class="fw-bold"><t t-esc="state.aiStats.consults_semaine || '0'"/></h2>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- KPI 2 -->
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #ffc107;">
                                    <div class="card-body">
                                        <i class="fa fa-money fa-3x text-warning mb-3"/>
                                        <h5 class="card-title text-muted">Impayés CNAM</h5>
                                        <h2 class="fw-bold text-warning"><t t-esc="state.aiStats.impayes_montant || '0'"/> DT</h2>
                                        <p class="text-muted small mb-0">Attente moy: <t t-esc="state.aiStats.jours_attente_moyens || '0'"/>j</p>
                                    </div>
                                </div>
                            </div>

                            <!-- KPI 3 -->
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #dc3545;">
                                    <div class="card-body">
                                        <i class="fa fa-exclamation-triangle fa-3x text-danger mb-3"/>
                                        <h5 class="card-title text-muted">Bordereaux Rejetés</h5>
                                        <h2 class="fw-bold text-danger"><t t-esc="state.aiStats.rejetes_mois || '0'"/></h2>
                                        <p class="text-muted small mb-0">Ce mois-ci</p>
                                    </div>
                                </div>
                            </div>

                            <!-- KPI 4 -->
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #28a745;">
                                    <div class="card-body">
                                        <i class="fa fa-users fa-3x text-success mb-3"/>
                                        <h5 class="card-title text-muted">Patients CNAM</h5>
                                        <h2 class="fw-bold text-success"><t t-esc="Math.round(state.aiStats.taux_cnam) || '0'"/> %</h2>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-4 mb-2">
                                <h5 class="text-secondary border-bottom pb-2"><i class="fa fa-calendar-check-o me-2"/>Activité Quotidienne</h5>
                            </div>
                            <!-- NOUVEAUX KPIs SECRETAIRE -->
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #6f42c1;">
                                    <div class="card-body">
                                        <i class="fa fa-user-plus fa-3x text-purple mb-3" style="color:#6f42c1;"/>
                                        <h5 class="card-title text-muted">Nouveaux Patients</h5>
                                        <h2 class="fw-bold" style="color:#6f42c1;"><t t-esc="state.aiStats.patients_crees_mois || '0'"/></h2>
                                        <p class="text-muted small mb-0">Ce mois-ci</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #fd7e14;">
                                    <div class="card-body">
                                        <i class="fa fa-calendar-times-o fa-3x mb-3" style="color:#fd7e14;"/>
                                        <h5 class="card-title text-muted">RDV Annulés</h5>
                                        <h2 class="fw-bold" style="color:#fd7e14;"><t t-esc="state.aiStats.rdv_annules || '0'"/></h2>
                                        <p class="text-muted small mb-0">Sur <t t-esc="state.aiStats.rdv_total || '0'"/> RDV (mois)</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #20c997;">
                                    <div class="card-body">
                                        <i class="fa fa-credit-card fa-3x mb-3" style="color:#20c997;"/>
                                        <h5 class="card-title text-muted">Montant Encaissé</h5>
                                        <h2 class="fw-bold" style="color:#20c997;"><t t-esc="state.aiStats.montant_encaisse_mois || '0'"/> DT</h2>
                                        <p class="text-muted small mb-0">Ce mois-ci</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center h-100 p-3" style="border-bottom: 4px solid #e83e8c;">
                                    <div class="card-body">
                                        <i class="fa fa-address-card-o fa-3x mb-3" style="color:#e83e8c;"/>
                                        <h5 class="card-title text-muted">Dossiers Incomplets</h5>
                                        <h2 class="fw-bold" style="color:#e83e8c;"><t t-esc="Math.round(state.aiStats.taux_dossiers_incomplets) || '0'"/> %</h2>
                                        <p class="text-muted small mb-0"><t t-esc="state.aiStats.dossiers_incomplets_count || '0'"/> patients</p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    
                    <!-- GRAPHIQUES ET LISTES (M7) -->
                    <t t-if="state.isMedecin">
                        <div class="row g-4 mt-2">
                            <!-- US35 -->
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0 h-100 p-3">
                                    <h5 class="card-title text-dark fw-bold border-bottom pb-2" style="font-size: 1.05rem;"><i class="fa fa-bar-chart text-info me-2"/>Consultations par Mois</h5>
                                    <div class="card-body d-flex flex-column">
                                        <div style="position: relative; height:250px; width:100%;">
                                            <canvas id="chart_us35"></canvas>
                                        </div>
                                        <t t-if="state.aiStats.ai_us35">
                                            <div class="alert alert-light border mt-3 mb-0 p-2 small text-muted">
                                                <i class="fa fa-magic text-warning me-2"/><strong>Analyse IA :</strong> <t t-esc="state.aiStats.ai_us35"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- US36 -->
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0 h-100 p-3">
                                    <h5 class="card-title text-dark fw-bold border-bottom pb-2" style="font-size: 1.05rem;"><i class="fa fa-pie-chart text-success me-2"/>CA par Scénario de Facturation</h5>
                                    <div class="card-body d-flex flex-column">
                                        <div style="position: relative; height:250px; width:100%;">
                                            <canvas id="chart_us36"></canvas>
                                        </div>
                                        <t t-if="state.aiStats.ai_us36">
                                            <div class="alert alert-light border mt-3 mb-0 p-2 small text-muted">
                                                <i class="fa fa-magic text-warning me-2"/><strong>Analyse IA :</strong> <t t-esc="state.aiStats.ai_us36"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- US37 -->
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0 h-100 p-3">
                                    <h5 class="card-title text-dark fw-bold border-bottom pb-2" style="font-size: 1.05rem;"><i class="fa fa-line-chart text-warning me-2"/>Créances CNAM en attente</h5>
                                    <div class="card-body d-flex flex-column">
                                        <div style="position: relative; height:250px; width:100%;">
                                            <canvas id="chart_us37"></canvas>
                                        </div>
                                        <t t-if="state.aiStats.ai_us37">
                                            <div class="alert alert-light border mt-3 mb-0 p-2 small text-muted">
                                                <i class="fa fa-magic text-warning me-2"/><strong>Analyse IA :</strong> <t t-esc="state.aiStats.ai_us37"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- US39 -->
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0 h-100 p-3">
                                    <h5 class="card-title text-dark fw-bold border-bottom pb-2" style="font-size: 1.05rem;"><i class="fa fa-users text-primary me-2"/>Répartition des Patients</h5>
                                    <div class="card-body d-flex flex-column">
                                        <div style="position: relative; height:250px; width:100%;">
                                            <canvas id="chart_us39"></canvas>
                                        </div>
                                        <t t-if="state.aiStats.ai_us39">
                                            <div class="alert alert-light border mt-3 mb-0 p-2 small text-muted">
                                                <i class="fa fa-magic text-warning me-2"/><strong>Analyse IA :</strong> <t t-esc="state.aiStats.ai_us39"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    
                    <!-- LISTE SECRETAIRE -->
                    <t t-else="">
                        <div class="row g-4 mt-2">
                            <div class="col-12">
                                <div class="card shadow-sm border-0 p-3">
                                    <h5 class="card-title text-secondary border-bottom pb-2"><i class="fa fa-list me-2"/>Rendez-vous prévus aujourd'hui</h5>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-striped mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Heure</th>
                                                        <th>Patient</th>
                                                        <th>Motif</th>
                                                        <th>Statut</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-if="state.aiStats.rdvs_today and state.aiStats.rdvs_today.length > 0">
                                                        <tr t-foreach="state.aiStats.rdvs_today" t-as="rdv" t-key="rdv_index">
                                                            <td class="fw-bold"><t t-esc="rdv.heure"/></td>
                                                            <td><t t-esc="rdv.patient"/></td>
                                                            <td><t t-esc="rdv.motif"/></td>
                                                            <td><span class="badge bg-info text-white"><t t-esc="rdv.statut"/></span></td>
                                                        </tr>
                                                    </t>
                                                    <t t-else="">
                                                        <tr>
                                                            <td colspan="4" class="text-center text-muted py-3">Aucun rendez-vous prévu pour aujourd'hui.</td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

            </div>
        </div>
    </t>
</templates>
