<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Report Feuille de Soins -->
    <record id="action_report_feuille_soins" model="ir.actions.report">
        <field name="name">Feuille de Soins (Assurance)</field>
        <field name="model">cabinet.facture</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cabinet_medical.report_feuille_soins_template</field>
        <field name="report_file">cabinet_medical.report_feuille_soins_template</field>
        <field name="print_report_name">'Feuille Soins - %s' % (object.patient_id.name)</field>
        <field name="binding_model_id" ref="model_cabinet_facture"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template QWeb Feuille de Soins -->
    <template id="report_feuille_soins_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="p" t-value="doc.patient_id"/>
                    <div class="page" style="font-family: Arial, sans-serif;">
                        <h2 class="text-center">FEUILLE DE SOINS MALADIE</h2>
                        <h3 class="text-center" style="border: 1px solid black; padding: 5px; background-color: #f8f9fa;">
                            Assurance Privée : <strong><span t-field="p.assurance_id.name"/></strong>
                        </h3>
                        
                        <!-- En-tête Médecin -->
                        <div class="row mt-4">
                            <div class="col-12" style="border: 1px solid #000; padding: 10px;">
                                <strong>Médecin Traitant : </strong> <span t-esc="env.company.medecin_nom or env.company.name"/><br/>
                                <strong>INPE : </strong> <span t-esc="env.company.medecin_inpe"/><br/>
                                <strong>Code Convention : </strong> <span t-esc="env.company.medecin_code_convention"/>
                            </div>
                        </div>

                        <!-- Informations Assuré -->
                        <div class="row mt-3">
                            <div class="col-12" style="border: 1px solid #000; padding: 10px;">
                                <h4>Informations de l'Assuré</h4>
                                <strong>Nom et Prénom : </strong> <span t-field="p.name"/><br/>
                                <strong>Numéro de contrat / d'affiliation : </strong> <span t-field="p.assurance_numero"/><br/>
                            </div>
                        </div>
                        
                        <!-- Détail des actes -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>Détails de la Consultation (du <span t-field="doc.consultation_id.date_consultation" t-options='{"widget": "date"}'/>)</h4>
                                <table class="table table-bordered table-sm mt16">
                                    <thead>
                                        <tr class="bg-light">
                                            <th>Code Acte</th>
                                            <th>Description des soins</th>
                                            <th class="text-right">Montant (DT)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                         <t t-if="doc.consultation_id.acte_ids">
                                             <t t-foreach="doc.consultation_id.acte_ids" t-as="acte">
                                                 <tr>
                                                     <td><span t-field="acte.type_acte"/></td>
                                                     <td><span t-field="acte.description"/></td>
                                                     <td class="text-right"><span t-field="acte.montant"/></td>
                                                 </tr>
                                             </t>
                                         </t>
                                         <t t-else="">
                                             <tr>
                                                 <td><span>Consultation</span></td>
                                                 <td><span>Consultation médicale standard</span></td>
                                                 <td class="text-right"><span t-field="doc.montant_total"/></td>
                                             </tr>
                                         </t>
                                     </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Calculs Financiers Mutuelle -->
                        <div class="row mt-4">
                            <div class="col-12" style="border: 1px solid #000; padding: 10px; background-color: #f9f9f9;">
                                <h4>Calcul des Remboursements</h4>
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Montant total des honoraires :</strong></td>
                                        <td class="text-right"><strong><span t-field="doc.montant_total"/> DT</strong></td>
                                    </tr>
                                    <tr t-if="doc.part_cnam_display &gt; 0">
                                        <td>Part prise en charge par la CNAM :</td>
                                        <td class="text-right"><span t-field="doc.part_cnam_display"/> DT</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Taux de couverture de l'assurance :</strong></td>
                                        <td class="text-right"><span t-field="p.assurance_taux"/> %</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Remboursement Mutuelle estimé :</strong></td>
                                        <td class="text-right">
                                            <strong><span t-esc="'%.2f' % doc.part_assurance_display"/> DT</strong>
                                        </td>
                                    </tr>
                                    <tr style="border-top: 1px solid #ccc;">
                                        <td class="text-primary"><strong>Reste à charge final réel du patient :</strong></td>
                                        <td class="text-right text-primary">
                                            <strong><span t-esc="'%.2f' % doc.reste_a_charge_final"/> DT</strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Signature -->
                        <div class="row mt-5">
                            <div class="col-6 offset-6 text-center">
                                <strong>Cachet et Signature du médecin</strong>
                                <div style="height: 100px; border-bottom: 1px dotted black; margin-top: 20px;"></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
