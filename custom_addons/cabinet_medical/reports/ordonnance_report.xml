<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Déclaration de l'action de rapport -->
    <record id="action_report_ordonnance" model="ir.actions.report">
        <field name="name">Ordonnance</field>
        <field name="model">cabinet.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cabinet_medical.report_ordonnance_document</field>
        <field name="report_file">cabinet_medical.report_ordonnance_document</field>
        <field name="print_report_name">'Ordonnance - %s' % (object.patient_id.name)</field>
        <field name="binding_model_id" ref="model_cabinet_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template du rapport -->
    <template id="report_ordonnance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <!-- Récupération des paramètres -->
                    <t t-set="cabinet_nom" t-value="env.company.name or 'Cabinet Médical'"/>
                    <t t-set="cabinet_adresse" t-value="env.company.street or 'Adresse non définie'"/>
                    <t t-set="cabinet_telephone" t-value="env.company.phone or 'Téléphone non défini'"/>

                    <div class="page">
                        <!-- En-tête du cabinet -->
                        <div class="row">
                            <div class="col-6">
                                <h2 t-esc="cabinet_nom" style="color: #2c3e50; font-weight: bold;"/>
                                <div t-if="env.company.medecin_inpe"><strong>INPE: </strong><span t-esc="env.company.medecin_inpe"/></div>
                                <div t-if="env.company.medecin_code_convention"><strong>Code Convention: </strong><span t-esc="env.company.medecin_code_convention"/></div>
                                <div t-esc="cabinet_adresse" style="margin-top: 5px;"/>
                                <div>Tél: <span t-esc="cabinet_telephone"/></div>
                            </div>
                            <div class="col-6 text-right">
                                <div>Le <span t-field="doc.date_prescription" t-options='{"widget": "date"}'/></div>
                            </div>
                        </div>

                        <hr style="border-top: 2px solid #2c3e50; margin-top: 20px; margin-bottom: 20px;"/>

                        <!-- Informations du patient -->
                        <div class="row mt32 mb32">
                            <div class="col-12 text-center">
                                <h3>ORDONNANCE</h3>
                            </div>
                        </div>
                        <div class="row mb32">
                            <div class="col-12">
                                <strong>Patient : </strong>
                                <span t-field="doc.patient_id.name"/>
                            </div>
                        </div>

                        <!-- Tableau des médicaments -->
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Médicament</th>
                                    <th>Dosage</th>
                                    <th>Posologie</th>
                                    <th>Durée</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.ordonnance_line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.medicament"/></td>
                                        <td><span t-field="line.dosage"/></td>
                                        <td><span t-field="line.posologie"/></td>
                                        <td><span t-field="line.duree"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Instructions -->
                        <div class="row mt32" t-if="doc.instructions">
                            <div class="col-12">
                                <strong>Instructions :</strong>
                                <p t-field="doc.instructions"/>
                            </div>
                        </div>

                        <!-- Signature du Médecin -->
                        <div class="row mt32">
                            <div class="col-6"></div>
                            <div class="col-6 text-center">
                                <t t-if="doc.state == 'signed' and doc.signature_image">
                                    <div style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; background-color: #f8fafc;">
                                        <div style="font-weight: bold; color: #1e3a5f; margin-bottom: 6px; font-size: 13px;">
                                            Signature du médecin
                                        </div>
                                        <div style="margin: 8px 0;">
                                            <img t-att-src="image_data_uri(doc.signature_image)" style="max-height: 80px; max-width: 220px; object-fit: contain;"/>
                                        </div>
                                        <div style="font-weight: bold; color: #0f172a; font-size: 13px;">
                                            <t t-if="doc.medecin_signataire_id">
                                                Dr. <span t-field="doc.medecin_signataire_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="env.company.medecin_nom or env.company.name"/>
                                            </t>
                                        </div>
                                        <div style="font-size: 11px; color: #64748b; margin-top: 3px;" t-if="doc.date_signature">
                                            Signée le <span t-field="doc.date_signature" t-options='{"widget": "datetime", "format": "dd/MM/yyyy à HH:mm"}'/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <strong>Signature du médecin</strong>
                                    <div style="height: 90px; border-bottom: 1px dotted black; margin-top: 10px;"></div>
                                </t>
                            </div>
                        </div>

                        <!-- Mention légale / Authentification -->
                        <div class="row mt32">
                            <div class="col-12 text-center text-muted" style="font-size: 11px; font-style: italic; border-top: 1px solid #dee2e6; padding-top: 10px; margin-top: 20px;">
                                <t t-if="doc.state == 'signed'">
                                    Ordonnance signée par le médecin — <span t-esc="cabinet_nom"/>
                                </t>
                                <t t-else="">
                                    Document généré par le <span t-esc="cabinet_nom"/> — à faire signer par le médecin.
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
