<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Règle de sécurité pour cabinet.patient (Accès portail) -->
        <record id="rule_cabinet_patient_portal" model="ir.rule">
            <field name="name">Patient Portal: Own Record Only</field>
            <field name="model_id" ref="cabinet_medical.model_cabinet_patient"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

