<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Override du template QWeb de l'email de réinitialisation de mot de passe.
        Remplace le logo relatif /logo.png par notre logo via URL absolue.
        Traduit le contenu en français.
        Remplace le bouton violet Odoo par le bleu marine du cabinet.
    -->
    <template id="reset_password_email_cabinet"
              inherit_id="auth_signup.reset_password_email"
              name="Cabinet: Reset Password Email">

        <!-- 1. Remplacer "Your Account" par "Votre compte" -->
        <xpath expr="//span[@style='font-size: 10px;']" position="replace">
            <span style="font-size: 10px;">Votre compte</span>
        </xpath>

        <!-- 2. Remplacer le logo company (URL relative /logo.png) par le logo de la compagnie via CID -->
        <xpath expr="//td[@valign='middle'][@align='right']" position="replace">
            <td valign="middle" align="right" style="text-align: right;">
                <img src="cid:logo_cabinet"
                     style="padding: 0px; margin: 0px 0px 4px 0px; height: 60px; width: auto; display: block; margin-left: auto;"
                     alt="Logo"/><br/>
                <span style="font-size: 11px; font-weight: bold; color: #1a3a6e;">
                    <t t-out="object.company_id.name or ''">Cabinet Médical</t>
                </span>
            </td>
        </xpath>

        <!-- 3. Traduire le corps du message - cible le div EXTÉRIEUR du corps -->
        <xpath expr="//td[@valign='top']/div" position="replace">
            <div>
                Bonjour <t t-out="object.name or ''">Utilisateur</t>,<br/><br/>
                Une réinitialisation du mot de passe a été demandée pour votre compte
                lié à cette adresse mail. Vous pouvez changer votre mot de passe
                en suivant ce lien qui restera valide pendant 24 heures :
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="object.signup_url"
                        style="background-color: #1a3a6e; padding: 12px 24px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px; font-weight: bold;">
                        Changer le mot de passe
                    </a>
                </div>
                Si vous ne vous attendez pas à ceci, vous pouvez ignorer cet e-mail.<br/><br/>
                Cordialement,
            </div>
        </xpath>

    </template>
</odoo>
