<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         VUE LISTE pour Secrétaire
         - Banner en haut (bandeau permanent)
         - Colonnes : Date, Heure, Nom patient, Type, Statut, Compléter dossier
         - Filtres rapides Aujourd'hui (défaut) / À venir
    ============================================================ -->
    <record id="view_appointment_list_secretaire" model="ir.ui.view">
        <field name="name">cabinet.rendezvous.list.secretaire</field>
        <field name="model">cabinet.rendezvous</field>
        <field name="arch" type="xml">
            <tree default_order="heure asc" export_xlsx="1"
                  create="0" edit="true" delete="0"
                  decoration-danger="is_urgence == True"
                  decoration-muted="state in ('annule', 'absent')"
                  decoration-success="state == 'termine'" limit="10">
                <field name="date" widget="date" string="Date"/>
                <field name="heure" widget="float_time" string="Heure"/>
                <field name="display_patient_name" string="Nom du Patient"/>
                <field name="appointment_type" widget="badge"
                       decoration-danger="appointment_type == 'urgence'"
                       decoration-info="appointment_type == 'normal'"
                       string="Type"/>
                <field name="no_show_risk_badge" widget="html" string="Risque No-Show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'en_attente'"
                       decoration-success="state == 'present'"
                       decoration-info="state == 'en_consultation'"
                       decoration-muted="state == 'termine'"
                       decoration-danger="state in ('annule', 'absent')"
                       string="Statut"/>
                <field name="is_urgence" column_invisible="True"/>
                <field name="is_nouveau_patient" column_invisible="True"/>
                <field name="is_dossier_incomplet" column_invisible="True"/>
                <field name="is_past_unclosed" column_invisible="True"/>
                <!-- Bouton Compléter dossier : visible si patient sans dossier OU dossier incomplet -->
                <button name="action_creer_patient_complet"
                        type="object"
                        string="Compléter dossier"
                        class="btn-warning btn-sm"
                        icon="fa-user-plus"
                        invisible="not is_dossier_incomplet"
                        groups="cabinet_medical.group_secretaire"/>
            </tree>
        </field>
    </record>


    <!-- ============================================================
         VUE FORMULAIRE pour Secrétaire
         - Création : date pré-remplie, slot_availability_status en temps réel
         - Édition : boutons selon statut (En attente / Présent / En consultation)
         - Pas de bouton Supprimer (bloqué dans le modèle)
    ============================================================ -->
    <record id="view_appointment_form_secretaire_edit" model="ir.ui.view">
        <field name="name">cabinet.rendezvous.form.secretaire.edit</field>
        <field name="model">cabinet.rendezvous</field>
        <field name="arch" type="xml">
            <form create="true" edit="true" delete="0" string="Créer un rendez-vous">
                <!-- Masquer l'en-tête (barre de statut et boutons) lors de la création (not id) -->
                <header>
                    <!-- Champs de contrôle (invisibles) -->
                    <field name="id" invisible="1"/>
                    <field name="show_arrive_absent_buttons" invisible="1"/>
                    <field name="show_complete_button" invisible="1"/>
                    <field name="show_cancel_button" invisible="1"/>

                    <button name="action_patient_arrive"
                            string="Patient arrivé"
                            type="object"
                            class="btn-success"
                            icon="fa-check-circle"
                            invisible="not show_arrive_absent_buttons"/>
                    <button name="action_patient_absent"
                            string="Patient absent"
                            type="object"
                            class="btn-warning"
                            icon="fa-times-circle"
                            invisible="not show_arrive_absent_buttons"/>
                    <button name="action_annuler"
                            string="Annuler le RDV"
                            type="object"
                            class="btn-danger"
                            icon="fa-ban"
                            invisible="not show_cancel_button"/>

                    <!-- Barre de statut -->
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="en_attente,present,en_consultation,termine,annule,absent"/>
                </header>

                <sheet>
                    <field name="create_date" invisible="1"/>
                    <widget name="web_ribbon" title="Terminé" bg_color="text-bg-success" invisible="state != 'termine'"/>
                    <widget name="web_ribbon" title="Annulé" bg_color="text-bg-danger" invisible="state != 'annule'"/>
                    <widget name="web_ribbon" title="En consultation" bg_color="text-bg-info" invisible="state != 'en_consultation'"/>

                    <!-- Champs invisibles de contrôle -->
                    <field name="is_nouveau_patient" invisible="1"/>
                    <field name="is_dossier_incomplet" invisible="1"/>
                    <field name="is_cnam_expired" invisible="1"/>
                    <field name="is_apci_expired" invisible="1"/>
                    <field name="is_past_unclosed" invisible="1"/>

                    <!-- Alerte RDV passé non clôturé -->
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="not is_past_unclosed"
                         style="margin-bottom: 16px; border-left: 5px solid #fd7e14; background-color: #fff3cd; color: #856404;">
                        <h4 class="alert-heading" role="status" style="font-size: 15px; margin-bottom: 5px; font-weight: bold;">
                            <i class="fa fa-clock-o mr-2" title="Action requise"/> Rendez-vous passé non qualifié
                        </h4>
                        <p style="margin-bottom: 0; font-size: 13px;">
                            La date de ce rendez-vous est passée alors qu'il est resté <strong>"En attente"</strong>. 
                            Veuillez mettre à jour son statut réel en cliquant sur <strong>"Patient arrivé"</strong>, <strong>"Patient absent"</strong> ou <strong>"Annuler le RDV"</strong>.
                        </p>
                    </div>

                    <!-- Alertes Droits Assurance Expirés -->
                    <div class="alert alert-danger" role="alert" invisible="not is_cnam_expired and not is_apci_expired" style="margin-bottom: 16px; border-left: 5px solid #dc3545;">
                        <h4 class="alert-heading" role="status"><i class="fa fa-exclamation-triangle mr-2" title="Attention"/> Droits d'assurance expirés !</h4>
                        <div invisible="not is_cnam_expired"><strong>CNAM :</strong> La carte de l'assuré est expirée. Le patient doit la renouveler.</div>
                        <div invisible="not is_apci_expired"><strong>APCI :</strong> La décision de prise en charge est arrivée à échéance.</div>
                    </div>

                    <!-- Bannière nouveau patient -->
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="not is_dossier_incomplet"
                         style="margin-bottom: 16px; border-left: 5px solid #ffc107;">
                        <h4 class="alert-heading" role="status">
                            <i class="fa fa-user-plus mr-2" title="Nouveau patient"/> Dossier patient à compléter
                        </h4>
                        <p style="margin-bottom: 0;">
                            Ce patient n'a pas encore de dossier médical complet.
                            Utilisez le bouton <strong>"Compléter dossier"</strong> pour enregistrer ses informations.
                        </p>
                    </div>

                    <!-- Encart Prédiction IA Risque No-Show -->
                    <div class="alert alert-info"
                         role="alert"
                         invisible="state in ('termine', 'annule', 'absent')"
                         style="margin-bottom: 16px; border-left: 5px solid #0d6efd; background-color: #f0f7ff; color: #084298;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong style="font-size: 13px;"><i class="fa fa-line-chart mr-2"/> Estimation IA Risque No-Show (PoC) :</strong>
                                <span style="margin-left: 10px;"><field name="no_show_risk_badge" widget="html" readonly="1" nolabel="1"/></span>
                            </div>
                            <div style="font-size: 11px; color: #6c757d; font-style: italic;">
                                Modèle Random Forest (Délai, Habitudes patient, Créneau)
                            </div>
                        </div>
                        <div invisible="not no_show_risk_factors" style="font-size: 12px; margin-top: 5px; color: #495057;">
                            <strong>Facteurs clés :</strong> <field name="no_show_risk_factors" readonly="1" nolabel="1"/>
                        </div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 6px; border-top: 1px dashed #b6d4fe; padding-top: 4px;">
                            <i class="fa fa-info-circle mr-1" title="Information"/> <em>Indicateur d'aide à la décision : un risque élevé justifie un rappel préventif (SMS/Appel), sans constituer une certitude d'absence.</em>
                        </div>
                    </div>

                    <group>
                        <group>
                            <!-- Saisie nom ou sélection patient existant -->
                            <field name="patient_name"
                                   string="Nouveau patient (nom)"
                                   placeholder="Entrer le nom complet…"
                                   invisible="patient_id"/>
                            
                            <div class="oe_title" invisible="not patient_name and not patient_id" style="margin-bottom: 20px;" colspan="2">
                                <h1>
                                    <i class="fa fa-calendar-check-o text-primary mr-3" style="color: #017e84; margin-right: 15px;" title="RDV"/>
                                    <field name="display_patient_name" readonly="1" nolabel="1"/>
                                </h1>
                            </div>

                            <!-- Patient existant -->
                            <field name="patient_id" placeholder="Sélectionner un patient existant…"
                                   invisible="patient_name"/>
                            <field name="motif_rapide" placeholder="Motif de la consultation…"/>
                            <field name="date" widget="date"/>
                            <field name="heure" widget="float_time"/>
                            <field name="is_urgence" widget="boolean_toggle" string="Urgence"/>
                        </group>
                    </group>
                    <!-- Message de disponibilité en temps réel en pleine largeur -->
                    <field name="slot_availability_status" widget="html" readonly="1" nolabel="1"/>
                </sheet>
                <footer>
                    <button string="Enregistrer" special="save" class="btn-primary"/>
                    <button string="Ignorer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================
         VUE RECHERCHE pour Secrétaire
         - Recherche par nom patient ou date
         - Filtres Aujourd'hui / À venir
         - Filtres par statut
    ============================================================ -->
    <record id="view_appointment_search_secretaire_2" model="ir.ui.view">
        <field name="name">cabinet.rendezvous.search.secretaire</field>
        <field name="model">cabinet.rendezvous</field>
        <field name="arch" type="xml">
            <search string="Rechercher un rendez-vous">
                <!-- Recherche par nom ou date -->
                <field name="display_patient_name" string="Nom du patient"
                       filter_domain="['|', ('display_patient_name', 'ilike', self), ('patient_name', 'ilike', self)]"/>
                <field name="date" string="Date"/>
                <separator/>

                <!-- Filtre d'alerte RDV passés non clôturés -->
                <filter name="filter_past_unclosed"
                        string="⚠️ RDV passés à clôturer"
                        domain="[('date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '=', 'en_attente')]"/>
                <separator/>

                <!-- Filtres rapides date -->
                <filter name="filter_today"
                        string="Aujourd'hui"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_upcoming"
                        string="À venir"
                        domain="[('date', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>

                <!-- Filtres risque No-Show -->
                <filter name="filter_risk_high" string="Risque No-Show Élevé"
                        domain="[('no_show_risk_level', '=', 'eleve')]"/>
                <filter name="filter_risk_medium" string="Risque No-Show Moyen"
                        domain="[('no_show_risk_level', '=', 'moyen')]"/>
                <separator/>

                <!-- Filtres par statut -->
                <filter name="en_attente" string="En attente"
                        domain="[('state','=','en_attente')]"/>
                <filter name="present" string="Présents"
                        domain="[('state','=','present')]"/>
                <filter name="en_consultation" string="En consultation"
                        domain="[('state','=','en_consultation')]"/>
                <filter name="termine" string="Terminés"
                        domain="[('state','=','termine')]"/>
                <filter name="annule" string="Annulés"
                        domain="[('state','=','annule')]"/>
                <filter name="absent" string="Absents"
                        domain="[('state','=','absent')]"/>

                <group expand="0" string="Grouper par">
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date:day'}"/>
                    <filter name="group_patient" string="Patient"
                            context="{'group_by': 'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ACTION pour Secrétaire
         - Vue par défaut : calendrier (semaine)
         - Filtre par défaut : Aujourd'hui
    ============================================================ -->
    <record id="action_appointment_secretaire" model="ir.actions.act_window">
        <field name="name">📅 Liste des Rendez-vous</field>
        <field name="res_model">cabinet.rendezvous</field>
        <field name="limit">10</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="search_view_id" ref="view_appointment_search_secretaire_2"/>
        <field name="context">{'form_view_initial_mode': 'edit', 'search_default_filter_today': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_appointment_calendar')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_appointment_list_secretaire')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_appointment_form_secretaire_edit')})]"/>
    </record>

</odoo>


