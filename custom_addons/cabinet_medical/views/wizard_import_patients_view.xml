<odoo>
    <record id="view_wizard_import_patients_form" model="ir.ui.view">
        <field name="name">wizard.import.patients.form</field>
        <field name="model">cabinet.wizard.import.patients</field>
        <field name="arch" type="xml">
            <form string="Importation des Patients">
                <!-- Titre clair et sous-titre explicatif -->
                <div class="oe_title" style="margin-bottom: 20px;">
                    <h1><i class="fa fa-upload mr-2"/> Importation des Patients</h1>
                    <p class="text-muted" style="font-size: 14px;">Importer une liste de patients depuis un fichier Excel ou CSV</p>
                </div>

                <!-- Encadré d'information professionnel -->
                <sheet>
                    <!-- Encadré d'information professionnel -->
                    <div class="alert alert-info" role="status" style="border-left: 5px solid #17a2b8;">
                        <h5 class="alert-heading" style="margin-bottom: 10px;">
                            <i class="fa fa-info-circle mr-2"/> Instructions d'import
                        </h5>
                        <ul style="margin-bottom: 0; padding-left: 20px;">
                            <li><strong>Formats acceptés :</strong> Excel (.xlsx) et CSV (.csv)</li>
                            <li><strong>Colonnes obligatoires :</strong> Nom, Téléphone, CIN</li>
                        </ul>
                    </div>

                    <!-- Mise en valeur de la zone de fichier -->
                    <div style="background-color: #f8f9fa; border: 1px dashed #ced4da; padding: 20px; border-radius: 5px; text-align: center; margin-bottom: 20px;">
                        <strong style="display: block; margin-bottom: 10px; color: #495057;">Sélectionnez votre fichier à importer :</strong>
                        <field name="fichier_excel" widget="binary" filename="nom_fichier"/>
                        <field name="nom_fichier" invisible="1"/>
                    </div>

                    <!-- Zone de résultat -->
                    <div invisible="not resultat" class="alert alert-secondary" role="status" style="border-left: 5px solid #6c757d;">
                        <h5 class="alert-heading"><i class="fa fa-list-alt mr-2"/> Rapport d'importation</h5>
                        <field name="resultat" readonly="1" nolabel="1"/>
                    </div>
                </sheet>

                <footer>
                    <button name="action_importer" type="object" string="Lancer l'importation" class="btn-primary" icon="fa-check"/>
                    <button string="Annuler" class="btn-secondary" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vue de confirmation de succès avec bouton OK -->
    <record id="view_wizard_import_patients_success_form" model="ir.ui.view">
        <field name="name">wizard.import.patients.success.form</field>
        <field name="model">cabinet.wizard.import.patients.success</field>
        <field name="arch" type="xml">
            <form string="Importation Réussie">
                <div class="text-center" style="padding: 25px 15px 15px 15px;">
                    <div style="width: 70px; height: 70px; margin: 0 auto 15px auto; background-color: #d4edda; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="fa fa-check-circle" style="font-size: 42px; color: #28a745;"/>
                    </div>
                    <h3 style="color: #155724; font-weight: bold; margin-bottom: 15px;">Importation Réussie !</h3>
                    <div style="background-color: #f8f9fa; border-radius: 8px; padding: 15px; margin-bottom: 10px; border: 1px solid #e9ecef;">
                        <field name="message" readonly="1" nolabel="1" style="font-size: 15px; color: #333; line-height: 1.6; white-space: pre-wrap;"/>
                    </div>
                </div>
                <footer>
                    <button name="action_ok" type="object" string="OK" class="btn-success" icon="fa-check" style="min-width: 100px; font-weight: bold;"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_patients" model="ir.actions.act_window">
        <field name="name">Import patients Excel</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cabinet.wizard.import.patients</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wizard_import_patients_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="cabinet_medical.model_cabinet_patient"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
